{
  "name": "life-atlas",
  "version": "1.7.0",
  "description": "Life Atlas — Offline-first personal workspace, notes, databases, and encrypted vault",
  "author": "Mendax",
  "private": true,
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "assets:icons": "node scripts/generate-icon-registry.mjs && node scripts/generate-emoji-registry.mjs",
    "assets:covers": "node scripts/build-cover-library.mjs",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"tests/*.test.mjs\"",
    "test:compatibility": "node scripts/check-data-compatibility.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs release",
    "desktop:build:test": "node scripts/desktop-build.mjs test",
    "test:e2e:desktop": "node --test --test-concurrency=1 \"tests/desktop/*.e2e.mjs\"",
    "test:release": "node scripts/run-release-tests.mjs",
    "guard:memory": "node scripts/run-memory-guard.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:workspace": "node --test tests/workspace-search.test.mjs",
    "test:appearance": "node --test tests/appearance-assets.test.mjs",
    "test:persistence": "node --test tests/workspace-persistence.test.mjs",
    "test:visual-scale": "node --test tests/page-visual-scale.test.mjs",
    "test:page-actions": "node --test tests/page-actions.test.mjs",
    "test:export": "node --test tests/page-export.test.mjs",
    "test:trash": "node --test tests/trash.test.mjs",
    "test:database": "node --test tests/database.test.mjs",
    "test:database-views": "node --test tests/database-views.test.mjs",
    "test:database-ui": "node --test tests/database-ui.test.mjs",
    "test:editor-blocks": "node --test tests/editor-blocks.test.mjs",
    "test:parity:phase1": "node scripts/run-parity.mjs phase1",
    "test:parity:phase2": "node scripts/run-parity.mjs phase2",
    "test:parity:phase3": "node scripts/run-parity.mjs phase3",
    "test:parity:browser": "node tests/core-parity-browser.mjs",
    "verify:parity:delivery": "node scripts/verify-parity-delivery.mjs"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "tesseract.js-core": "7.0.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@blocknote/code-block": "0.54.2",
    "@blocknote/core": "^0.54.2",
    "@blocknote/mantine": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@emoji-mart/data": "^1.2.1",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@fontsource/dm-sans": "5.3.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tabler/icons-react": "^3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.5",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "0.19.1",
    "leaflet": "1.9.4",
    "playwright": "1.63.0",
    "postcss": "8.5.16",
    "qrcode-generator": "2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.4",
    "vite": "6.4.2"
  }
}
